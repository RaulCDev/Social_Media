# Local development defaults. Replace secret placeholders in your private .env.
MYSQL_DATABASE=socialmedia
MYSQL_USER=socialmedia
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql+pymysql://socialmedia:replace-with-a-local-password@db-mysql:3306/socialmedia

FLASK_SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

API_PORT=5000
NODE_ENV=development
