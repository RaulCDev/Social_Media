# Local development defaults. Replace secret placeholders in your private .env.
MYSQL_DATABASE=socialmedia
MYSQL_USER=socialmedia
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql+pymysql://socialmedia:replace-with-a-local-password@db-mysql:3306/socialmedia

FLASK_SECRET_KEY=replace-with-a-long-random-value
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=60
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
POST_IP_RATE_LIMIT=20
COMMENT_IP_RATE_LIMIT=60
LIKE_RATE_LIMIT=30
LIKE_IP_RATE_LIMIT=100
SESSION_IP_RATE_LIMIT=10
WRITE_RATE_WINDOW_SECONDS=60
SESSION_RATE_WINDOW_SECONDS=60

# Production example (use only explicit HTTPS origins and secure cookies):
# APP_ENV=production
# FRONTEND_ORIGIN=https://social.example.com,https://www.social.example.com
# COOKIE_SECURE=true

API_PORT=5000
NODE_ENV=development
